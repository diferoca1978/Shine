---
import MainLayout from "@/layouts/MainLayout.astro";
import ServicesHero from "@/components/section/ourServices/ServicesHero.astro";
import ServiceCard from "@/components/ui/ServiceCard.astro";
import { services } from "@/config/services";
import {
  generateCollectionPageSchema,
  generatePageSEO,
} from "@/config/seo";
import { COMPANY_INFO } from "@/config/companyInfo";
import { siteUrl } from "@/utils/url";

const servicesSEO = generatePageSEO({
  title: "Servicios: Diseño Web, Ads y Ecommerce",
  description:
    "Diseño web con Astro, campañas de Google Ads y Facebook Ads, y ecommerce con Tienda Nube: tres servicios digitales en un solo equipo para negocios en Colombia.",
  path: "/servicios",
});

const collectionSchema = generateCollectionPageSchema({
  name: "Servicios",
  path: "/servicios",
  description: servicesSEO.description,
  hasPart: services.map((service) => ({
    "@type": "Service",
    "@id": `${COMPANY_INFO.url}/servicios/${service.slug}#service`,
    name: service.title,
    url: siteUrl(`/servicios/${service.slug}`),
  })),
});
---

<MainLayout
  seoProps={servicesSEO}
  aditionalSchemas={[collectionSchema]}
>
  <ServicesHero />

  <section class="services-list-wrapper w-full mx-auto">
    <div class="max-w-7xl mx-auto px-4 pb-16 md:pb-20">
      <div
        class="services-grid grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3"
      >
        {
          services.map((service) => (
            <ServiceCard
              slug={service.slug}
              image={service.image}
              alt={service.alt}
              title={service.title}
              description={service.subtitle || ""}
              tags={service.tags || []}
            />
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
