---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import "highlight.js/styles/github-dark.css";
import Prose from "@/components/ui/Prose.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import ArrowUp from "@/assets/icons/arrowUp.svg";
import { getReadingTime } from "@/utils/readinTime";
import { AUTHORS } from "@/config/authors";
import { getServiceBySlug } from "@/config/services";
import RelatedPosts from "@/components/section/RelatedPosts.astro";
import { getRelatedPosts } from "@/utils/posts";

// Generate all possible paths
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

// Per path let's generate the page
const { post } = Astro.props;
const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: post.data.title, path: `/blog/${post.data.slug}/` },
];

// To render the blog content
const { Content, headings } = await render(post);


// Get author info from local config (enriches CMS data with bio, credentials, etc.)
const author = AUTHORS.find((author) => author.name === post.data.author);
if (!author) {
  throw new Error(
    `Author "${post.data.author}" on blog post "${post.id}" is not registered in AUTHORS (src/config/authors.ts).`,
  );
}

// Related content (services this post supports + sibling posts)
const relatedServices = (post.data.services ?? []).flatMap((slug) => {
  const service = getServiceBySlug(slug);
  return service ? [service] : [];
});
const relatedPosts = await getRelatedPosts(post);

// Add reading time
const readingTime = post.body ? getReadingTime(post.body) : "";

const formatDate = (date: Date): string =>
  new Date(date).toLocaleDateString("es-CO", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<PostLayout post={post} {breadcrumbs}>
  <article class="container md:mt-0 mx-auto px-2 py-8 md:py-12">
    <div class="max-w-4xl px-4 sm:px-6 lg:px-8 mx-auto">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="max-w-5xl px-2 pt-6 lg:pt-10 pb-12 sm:px-6 lg:px-8 mx-auto">
      <div class="flex justify-center h-90 mx-auto mb-8">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          priority
          class="object-cover w-full h-full rounded-2xl"
        />
      </div>
      <div class="space-y-5 md:space-y-8">
        <h1
          class="text-center font-bold mb-5 text-[min(6vw,36px)] dark:text-softWhite"
        >
          {post.data.title}
        </h1>
        <p
          class="text-[min(5vw,20px)] text-balance text-center text-deepdark-900 dark:text-softWhite"
        >
          {post.data.description}
        </p>

        <!-- Author & Post Meta -->
        <div
          class="mb-8 flex flex-col sm:flex-row sm:items-start gap-4 border-y border-deepdark-200 dark:border-softWhite/20 py-4"
        >
          <!-- Author Info -->
          <div class="flex-1">
            <p class="font-medium text-deepdark-900 dark:text-softWhite">
              Por: {author.name}
            </p>
            <p class="text-sm text-deepdark-500 dark:text-softWhite/80">
              {author.role}
            </p>
            <p
              class="text-sm text-deepdark-500 dark:text-softWhite/70 mt-1 max-w-prose"
            >
              {author.bio}
            </p>
          </div>
          <!-- Post Meta -->
          <div
            class="text-sm text-deepdark-500 dark:text-softWhite/80 sm:text-right shrink-0"
          >
            <p>Publicado el: {formatDate(post.data.pubDate)}</p>
            {
              post.data.modifiedDate &&
                post.data.modifiedDate.getTime() !== post.data.pubDate.getTime() && (
                  <p>Actualizado: {formatDate(post.data.modifiedDate)}</p>
                )
            }
            <p class="text-deepdark dark:text-softWhite/70">{readingTime}</p>
          </div>
        </div>
      </div>
      <div class="max-w-5xl pt-6 pb-12 mx-auto border-b border-deepdark-200 dark:border-softWhite/20 mb-8">
        <h2 class="text-deepdark-900 dark:text-softWhite mb-4 font-bold">Índice</h2>
        <ul class="flex flex-col gap-1">
          {headings.map((heading) => (
            <li class="text-deepdark-900 dark:text-softWhite hover:text-accentGold">
              {heading.depth === 2 ? (
                <span class="text-accentGold">•</span>
                <a href={`#${heading.slug}`}> {heading.text}</a>
              ) : (
                ""
              )}
            </li>
          ))}
        </ul>
      </div>
      <Prose>
        <Content />
        <div>
          <button
          type="button"
          id="back-to-top"
          class="cursor-pointer flex items-center text-sm font-medium text-smokyBlack dark:text-softWhite/80 px-2 py-1 rounded-md border border-deepplum dark:border-softWhite/20 hover:bg-accentGold/5 hover:text-deepdark-900 hover:backdrop-blur-sm dark:hover:text-softWhite"
          >Volver Arriba <ArrowUp class="ml-2 w-4 h-4 text-deepdark-900 dark:text-softWhite"/></button>
        </div>
      </Prose>
    </div>
  </article>
  {
    relatedServices.length > 0 && (
      <aside
        aria-labelledby="related-service-label"
        class="w-full pb-4 md:pb-6"
      >
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-xl border border-smokyBlack/10 dark:border-softWhite/10 bg-softWhite/50 dark:bg-smokyBlack/50 p-5">
            <p
              id="related-service-label"
              class="text-sm font-semibold uppercase tracking-wide text-smokyBlack/80 dark:text-softWhite/80 mb-3"
            >
              Servicio relacionado
            </p>
            <ul class="flex flex-col gap-2">
              {relatedServices.map((service) => (
                <li>
                  <a
                    href={`/servicios/${service.slug}/`}
                    class:list={[
                      "text-lg font-semibold text-deepplum dark:text-accentGold hover:underline hover:underline-offset-2",
                      "focus-ring",
                    ]}
                  >
                    {service.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    )
  }
  <RelatedPosts heading="Artículos relacionados" posts={relatedPosts} />
</PostLayout>

<script>
  // Back to top — delegate to Lenis so it stays smooth and controlled
  import { lenis } from "@/utils/scripts/lenis/lenisSmooth.js";

  const backToTopButton = document.querySelector("#back-to-top") as HTMLButtonElement;
  backToTopButton.addEventListener("click", () => {
    lenis.scrollTo(0, { duration: 1.2 });
  });
</script>
  




