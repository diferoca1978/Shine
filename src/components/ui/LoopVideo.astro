---
import type { ImageMetadata } from "astro";
import PlayIcon from "@/assets/icons/play.svg";
import PauseIcon from "@/assets/icons/pause.svg";
import SoundOnIcon from "@/assets/icons/soundOn.svg";
import SoundOffIcon from "@/assets/icons/soundOff.svg";

interface Props {
  mp4: string;
  webm: string;
  poster: ImageMetadata;
  label: string;
  class?: string;
}

const { mp4, webm, poster, label, class: className } = Astro.props;

const controlClass =
  "flex h-10 w-10 items-center justify-center rounded-full border border-softWhite/40 bg-smokyBlack/60 text-softWhite backdrop-blur-sm transition-colors hover:bg-smokyBlack focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGold focus-visible:ring-offset-2 focus-visible:ring-offset-smokyBlack motion-reduce:transition-none";
---

<div
  class:list={["group relative aspect-3/4 w-full overflow-hidden bg-smokyBlack", className]}
  data-loop-video
>
  <video
    class="absolute inset-0 h-full w-full object-cover"
    muted
    loop
    playsinline
    preload="none"
    poster={poster.src}
    width={poster.width}
    height={poster.height}
    aria-label={label}
    data-video
  >
    <source src={webm} type="video/webm" />
    <source src={mp4} type="video/mp4" />
  </video>

  <div
    class="absolute inset-x-0 bottom-0 flex items-center justify-end gap-2 bg-linear-to-t from-smokyBlack/70 to-transparent p-3 pt-10"
  >
    <button
      type="button"
      aria-label="Reproducir video"
      data-video-toggle
      class={controlClass}
    >
      <PlayIcon class="h-4 w-4 group-data-playing:hidden" aria-hidden="true" />
      <PauseIcon class="hidden h-4 w-4 group-data-playing:block" aria-hidden="true" />
    </button>
    <button
      type="button"
      aria-label="Activar sonido"
      data-video-sound
      class={controlClass}
    >
      <SoundOffIcon class="h-4 w-4 group-data-unmuted:hidden" aria-hidden="true" />
      <SoundOnIcon class="hidden h-4 w-4 group-data-unmuted:block" aria-hidden="true" />
    </button>
  </div>
</div>

<script>
  import { problemVideo } from "@/utils/scripts/perPageAnimations/servicesAnimations/problemVideo.js";
  problemVideo();
</script>
