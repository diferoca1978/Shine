---
import type { getIndustriesWithProjects } from "@/utils/projects";
import DropdownIcon from "@/assets/icons/dropdown.svg";

interface Props {
  industries: Awaited<ReturnType<typeof getIndustriesWithProjects>>;
  activeSlug: string;
}

const { industries, activeSlug } = Astro.props;

const activeGroup = industries.find((group) =>
  group.projects.some((project) => project.data.slug === activeSlug),
);
const activeProject = activeGroup?.projects.find(
  (project) => project.data.slug === activeSlug,
);
---

<button
  type="button"
  id="proyectos-sidebar-trigger"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="proyectos-sidebar"
  class="mb-8 flex w-full items-center justify-between gap-3 rounded-full border border-smokyBlack/15 px-5 py-3 text-sm text-smokyBlack focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGreen focus-visible:ring-offset-2 lg:hidden dark:border-softBeige/15 dark:text-softWhite"
>
  <span class="truncate" data-sidebar-trigger-label>
    {activeGroup?.label} · {activeProject?.data.title}
  </span>
  <svg
    class="h-4 w-4 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16" />
  </svg>
</button>

<aside
  id="proyectos-sidebar"
  class="hidden w-full flex-col lg:flex lg:w-60 lg:shrink-0"
>
  <div class="flex items-center justify-between lg:hidden">
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-smokyBlack/50 dark:text-softBeige/50">
      Categorías
    </span>
    <button
      type="button"
      id="proyectos-sidebar-close"
      aria-label="Cerrar"
      class="rounded-full p-2 text-smokyBlack focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGreen focus-visible:ring-offset-2 dark:text-softWhite"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M6 18L18 6" />
      </svg>
    </button>
  </div>

  <div
    class="hidden text-xs font-bold uppercase tracking-[0.22em] text-smokyBlack/50 lg:block dark:text-softBeige/50"
  >
    Categorías
  </div>
  <div class="mt-4 h-px bg-smokyBlack/10 dark:bg-softBeige/10 lg:mt-[18px]"></div>

  {
    industries.map((group) => {
      const isOpen = group.industry === activeGroup?.industry;
      return (
        <div>
          <button
            type="button"
            data-industry-trigger
            data-industry={group.industry}
            data-state={isOpen ? "active" : undefined}
            aria-expanded={isOpen ? "true" : "false"}
            aria-controls={`industry-panel-${group.industry}`}
            class="group flex w-full items-center justify-between gap-3 border-b border-smokyBlack/10 py-4 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGreen dark:border-softBeige/10"
          >
            <span class="flex items-center gap-2.5">
              <DropdownIcon
                class="h-3 w-3 shrink-0 transition-transform duration-200 group-data-[state=active]:rotate-90"
                aria-hidden="true"
              />
              <span class="text-[15px] text-smokyBlack/70 group-data-[state=active]:font-bold group-data-[state=active]:text-smokyBlack dark:text-softBeige/70 dark:group-data-[state=active]:text-softWhite">
                {group.label}
              </span>
            </span>
            <span class="text-xs tabular-nums text-smokyBlack/50 dark:text-softBeige/50">
              {group.projects.length}
            </span>
          </button>
          <ul
            id={`industry-panel-${group.industry}`}
            data-industry-panel
            class:list={["flex flex-col py-2", !isOpen && "hidden"]}
          >
            {group.projects.map((project) => (
              <li>
                <a
                  href={`/proyectos/${project.data.slug}/`}
                  data-project-link
                  data-slug={project.data.slug}
                  data-state={project.data.slug === activeSlug ? "active" : undefined}
                  aria-current={project.data.slug === activeSlug ? "true" : undefined}
                  class="block border-l-2 border-transparent py-2 pl-5 text-sm leading-tight text-smokyBlack/60 hover:text-smokyBlack focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGreen data-[state=active]:border-accentGreen data-[state=active]:font-bold data-[state=active]:text-smokyBlack dark:text-softBeige/60 dark:hover:text-softWhite dark:data-[state=active]:text-softWhite"
                >
                  {project.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })
  }

  <div
    class="mt-9 rounded-2xl border border-smokyBlack/10 p-5 dark:border-softBeige/10"
  >
    <p class="text-[13px] leading-relaxed text-smokyBlack/70 dark:text-softBeige/70">
      ¿Tu sector no está en la lista? Igual sabemos posicionarlo.
    </p>
    <a
      href="/contacto/"
      class="mt-3 inline-block text-[13px] font-bold text-smokyBlack underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accentGreen dark:text-softWhite"
    >
      Hablemos
    </a>
  </div>
</aside>

<script>
  import { projectsAccordionAnimation } from "@/utils/scripts/perPageAnimations/proyectos/projectsAccordionAnimation.js";
  projectsAccordionAnimation();
</script>
