---
import { COMPANY_INFO } from "@/config/companyInfo";
import PhoneIcon from "@/assets/icons/phone.svg";
import MailIcon from "@/assets/icons/mail.svg";
import MapPinIcon from "@/assets/icons/mapPin.svg";
---

<section class="contact-info-section w-full mx-auto">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div
      class="grid grid-cols-1 sm:grid-cols-3 gap-px overflow-hidden rounded-2xl border border-smokyBlack/10 bg-smokyBlack/10 dark:border-softWhite/12 dark:bg-softWhite/12"
    >
      <a
        href={`tel:${COMPANY_INFO.phone}`}
        class="group flex flex-col gap-3 bg-softWhite dark:bg-smokyBlack p-6 transition-colors duration-300 hover:bg-softBeige dark:hover:bg-deepplum"
      >
        <PhoneIcon
          class="h-6 w-6 text-deepplum dark:text-accentGold"
          aria-hidden="true"
        />
        <div>
          <h3 class="text-sm font-medium text-smokyBlack/50 dark:text-softWhite/50">
            Teléfono/WhatsApp
          </h3>
          <p
            class="mt-1 text-lg text-smokyBlack dark:text-softWhite group-hover:text-deepplum dark:group-hover:text-accentGold transition-colors duration-300"
          >
            {COMPANY_INFO.phone}
          </p>
        </div>
      </a>

      <a
        href={`mailto:${COMPANY_INFO.email}`}
        class="group flex flex-col gap-3 bg-softWhite dark:bg-smokyBlack p-6 transition-colors duration-300 hover:bg-softBeige dark:hover:bg-deepplum"
      >
        <MailIcon
          class="h-6 w-6 text-deepplum dark:text-accentGold"
          aria-hidden="true"
        />
        <div>
          <h3 class="text-sm font-medium text-smokyBlack/50 dark:text-softWhite/50">
            Correo
          </h3>
          <p
            class="mt-1 text-lg text-smokyBlack dark:text-softWhite break-all group-hover:text-deepplum dark:group-hover:text-accentGold transition-colors duration-300"
          >
            {COMPANY_INFO.email}
          </p>
        </div>
      </a>

      <div class="group flex flex-col gap-3 bg-softWhite dark:bg-smokyBlack p-6 transition-colors duration-300 hover:bg-softBeige dark:hover:bg-deepplum ">
        <MapPinIcon
          class="h-6 w-6 text-deepplum dark:text-accentGold"
          aria-hidden="true"
        />
        <div class="">
          <h3 class="text-sm font-medium text-smokyBlack/50 dark:text-softWhite/50">
            Ubicación
          </h3>
          <p class="mt-1 text-lg text-smokyBlack dark:text-softWhite break-all group-hover:text-deepplum dark:group-hover:text-accentGold transition-colors duration-300">
            {COMPANY_INFO.address.city}, {COMPANY_INFO.address.country}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
