---
import { SEO } from "astro-seo";
import type { SEOProps } from "astro-seo";
import { JSONLD_STUB_REGISTRY, type JSONLDSchema } from "@/config/seo";
import { buildJsonLdGraph } from "@/utils/jsonLdGraph";

interface Props {
  seoProps: SEOProps;
  schemas?: JSONLDSchema[]; // To avoid the Type sctict error from typescript, more flexible.
}

const { seoProps, schemas = [] } = Astro.props;
const jsonLdGraph = buildJsonLdGraph(
  schemas,
  Astro.url.pathname,
  JSONLD_STUB_REGISTRY,
);
---

<SEO {...seoProps} />

{schemas.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
)}
